{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=barberhub;Username=postgres;Password=YOUR_DB_PASSWORD"
  },

  "Jwt": {
    "Issuer": "BarberHub.Api",
    "Audience": "BarberHub.Mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },

  "Features": {
    "OnlinePaymentEnabled": false,
    "ProductsEnabled": true,
    "EarningsFinancialsEnabled": true,
    "GoogleLoginEnabled": true,
    "EmailOtpLoginEnabled": true,
    "SmsOtpLoginEnabled": false,
    "MapsEnabled": false,
    "PushEnabled": false,
    "SuperAdminTwoFactorEnabled": false
  },

  "Otp": {
    "CodeLength": 6,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60
  },

  "Sms": {
    "Provider": "Console",
    "ApiKey": "",
    "SenderId": "BHUB",
    "TemplateId": ""
  },

  "Google": {
    "Maps": { "ApiKey": "" },
    "OAuth": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "Firebase": {
    "ServiceAccountJsonPath": "",
    "ServiceAccountJson": ""
  },

  "Queue": {
    "TickIntervalSeconds": 60,
    "AutoCancelPendingMinutes": 30,
    "ReminderMinutesBefore": 60
  },

  "RateLimit": {
    "OtpPerHour": 60,
    "LoginPerMinute": 60
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "",
    "SenderName": "Barber Hub",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },

  "Stripe": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": "",
    "Currency": "inr"
  }
}
